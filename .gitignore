# Build output
/build/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.vcxproj
*.vcxproj.filters
*.sln

# IDE and editor files, and the agent's local settings
.claude/settings.local.json
.vs/
.vscode/
.idea/
*.user
*.suo
*.swp

# Local game data — never commit
/data/
/roms/
/assets-extracted/
/generated/
*.nds
*.srl
*.rom
*.sav
# The player's save and settings (saves/settings.ini)
/saves/

# Emulator savestates, RAM dumps and traces (derived from the user's own ROM)
*.dst
*.dsv
*_state.bin

# Proprietary tools and SDKs — never commit
/NitroSDK/
/CodeWarrior/
mwccarm.exe
mwldarm.exe

# Platform files
.DS_Store
Thumbs.db

# Python caches
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp
*.bak

# The player's mods at the root (port/runtime/mods and studio/core/mods are source).
/mods/
# The fonts the installer takes from its pinned packages (installer/pinned.json), for tools/mods.
/installer/fonts/

# Frames the native build saves (KHDAYS_SHOTS, into shots/ by default).
/shots/
*.bmp

